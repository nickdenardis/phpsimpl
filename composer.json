{
    "name": "phpsimpl/simpl",
    "version": "2.0.14",
    "type": "library",
    "description": "PHPSimpl - a collection of useful PHP classes",
    "keywords": [
        "classes"
    ],
    "homepage": "https://github.com/nickdenardis/phpsimpl",
    "license": "LGPL-3.0",
    "authors": [
        {
            "name": "Nick DeNardis",
            "email": "nick.denardis@gmail.com"
        }
    ],
    "support": {
        "irc": "irc://irc.freenode.org/phpsimpl",
        "issues": "https://github.com/nickdenardis/phpsimpl/issues",
        "source": "https://github.com/nickdenardis/phpsimpl"
    },
    "require": {
        "php": ">=5.3",
        "rdlowrey/auryn": "v0.13.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0",
        "mockery/mockery": "^1.6"
    },
    "scripts": {
        "test": "pest",
        "test:cache-off": "USE_CACHE=false pest",
        "test:cache-on": "USE_CACHE=true pest",
        "test:all-cache": "USE_CACHE=false pest && USE_CACHE=true pest",
        "test:coverage": "pest --coverage"
    },
    "autoload": {
        "classmap": [
            "lib/"
        ],
        "files": [
            "lib/functions.php"
        ],
        "psr-0": {
            "Simpl": "lib"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
